		"captions": [
			{"t": 1.5, "until": 7, "text": "The Life of a\nLeafcutter Colony", "style": "title", "pos": "middle", "fade": 1.2},
			{"t": 7.5, "until": 13.5, "text": "Sealed deep underground, a young queen starts her colony."},
			{"t": 14, "until": 19.5, "text": "Beside her grows a fungus garden, from a pellet carried from her mother's nest."},
			{"t": 20, "until": 25, "text": "She lays her first eggs."},
			{"t": 26.5, "until": 31, "text": "Breaking ground", "style": "chapter", "pos": "top"},
			{"t": 27.5, "until": 33.5, "text": "Her first daughters grow up and dig toward the surface."},
			{"t": 36, "until": 41, "text": "The nest opens, and foragers set out to find fresh leaves."},
			{"t": 41.8, "until": 46.6, "text": "Days pass...", "pos": "top"},
			{"t": 47.5, "until": 52.5, "text": "Leaf to fungus", "style": "chapter", "pos": "top"},
			{"t": 53.5, "until": 59.5, "text": "A worker saws a fragment from the leaf and carries it home."},
			{"t": 63, "until": 69, "text": "Below, gardeners chew it to pulp and plant it in the fungus garden."},
			{"t": 72.5, "until": 77.5, "text": "Over the following days, the fungus grows through the fresh pulp."},
			{"t": 78, "until": 83, "text": "The ants cannot digest leaves. They farm the fungus, and its tips feed the larvae."},
			{"t": 84.5, "until": 89, "text": "Egg, larva, pupa, worker", "style": "chapter", "pos": "top"},
			{"t": 89.5, "until": 94.5, "text": "Nurses carry each new egg to a nursery of dark, damp clay."},
			{"t": 95, "until": 100.5, "text": "The egg hatches, and the larva moves to a nursery of warm red clay."},
			{"t": 103.5, "until": 108.5, "text": "There nurses feed it on the fungus's swollen tips."},
			{"t": 111.5, "until": 117, "text": "Fully grown, it rests as a pupa on dry, pale sand. Leafcutters spin no cocoon."},
			{"t": 117.3, "until": 120.3, "text": "A pale callow is freed from its pupal skin..."},
			{"t": 120.3, "until": 124, "text": "...and a new worker joins the colony."},
			{"t": 125.5, "until": 130.5, "text": "The trunk trail", "style": "chapter", "pos": "top"},
			{"t": 126.5, "until": 131.8, "text": "The colony has grown to hundreds. Their trail is a cleared highway."},
			{"t": 132.5, "until": 138.3, "text": "When debris falls across it, majors, the largest workers, carry it away."},
			{"t": 140, "until": 145.5, "text": "Tiny minims ride the fragments, guarding carriers from parasitic flies."},
			{"t": 147, "until": 151.5, "text": "Taking out the waste", "style": "chapter", "pos": "top"},
			{"t": 151.5, "until": 156.5, "text": "Spent garden and the dead are carried out to refuse heaps, away from the fungus."},
			{"t": 157, "until": 162.5, "text": "From one queen, a colony of hundreds. In time, it may hold millions."}
		],
