		"captions": [
			{"t": 1, "until": 5.5, "text": "The Life of a\nLeafcutter Colony", "style": "title", "pos": "top", "fade": 1.2},
			{"t": 3, "until": 7.5, "text": "Her nuptial flight over, a young queen comes down to earth."},
			{"t": 8, "until": 12, "text": "She will never fly again. She breaks off her wings."},
			{"t": 16, "until": 20, "text": "She digs down, and seals the shaft behind her."},
			{"t": 22, "until": 27.5, "text": "Sealed deep underground, she starts her colony."},
			{"t": 28, "until": 33.3, "text": "Beside her grows a fungus garden, from a pellet carried from her mother's nest."},
			{"t": 33.8, "until": 37.8, "text": "She lays her first eggs."},
			{"t": 39.5, "until": 44, "text": "Breaking ground", "style": "chapter", "pos": "top"},
			{"t": 40.5, "until": 46.5, "text": "Her first daughters grow up and dig toward the surface."},
			{"t": 49.5, "until": 54.5, "text": "The nest opens, and foragers set out to find fresh leaves."},
			{"t": 55.3, "until": 59.5, "text": "Days pass...", "pos": "top"},
			{"t": 60.5, "until": 65.5, "text": "Leaf to fungus", "style": "chapter", "pos": "top"},
			{"t": 66.5, "until": 72.5, "text": "A worker saws a fragment from the leaf and carries it home."},
			{"t": 76.5, "until": 82.5, "text": "Below, gardeners chew it to pulp and plant it in the fungus garden."},
			{"t": 84, "until": 88.5, "text": "Over the following days, the fungus grows through the fresh pulp."},
			{"t": 89, "until": 93.5, "text": "The ants cannot digest leaves. They farm the fungus, and its tips feed the larvae."},
			{"t": 94.5, "until": 99, "text": "Egg, larva, pupa, worker", "style": "chapter", "pos": "top"},
			{"t": 96, "until": 101.5, "text": "Nurses carry each new egg to a nursery of dark, damp clay."},
			{"t": 104.5, "until": 110.5, "text": "The egg hatches, and the larva moves to a nursery of warm red clay."},
			{"t": 115, "until": 120, "text": "There nurses feed it on the fungus's swollen tips."},
			{"t": 123.3, "until": 128.8, "text": "Fully grown, it rests as a pupa on dry, pale sand. Leafcutters spin no cocoon."},
			{"t": 132, "until": 135, "text": "A pale callow is freed from its pupal skin..."},
			{"t": 135.3, "until": 137.7, "text": "...and a new worker joins the colony."},
			{"t": 138.8, "until": 143, "text": "The trunk trail", "style": "chapter", "pos": "top"},
			{"t": 139.5, "until": 143.5, "text": "The colony has grown to hundreds. Their trail is a cleared highway."},
			{"t": 144, "until": 149, "text": "When debris falls across it, majors, the largest workers, carry it away."},
			{"t": 150, "until": 154.8, "text": "Tiny minims ride the fragments, guarding carriers from parasitic flies."},
			{"t": 155.8, "until": 159.8, "text": "Taking out the waste", "style": "chapter", "pos": "top"},
			{"t": 158, "until": 163.3, "text": "Spent garden and the dead are carried out to refuse heaps, away from the fungus."},
			{"t": 164.8, "until": 169.3, "text": "The next generation", "style": "chapter", "pos": "top"},
			{"t": 165.5, "until": 170.8, "text": "Years on, at dusk, the colony raises winged young queens and males."},
			{"t": 172, "until": 175.6, "text": "The big ones are young queens; the small dark ones, males."},
			{"t": 176, "until": 181.5, "text": "They fly off to mate. Each queen that survives can found a new colony."},
			{"t": 184, "until": 189.5, "text": "From one queen, a colony of hundreds. In time, it may hold millions."},
			{"t": 191, "until": 195.5, "text": "And the cycle starts again."}
		],
