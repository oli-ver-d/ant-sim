		"captions": [
			{"t": 1.5, "until": 7, "text": "The Life of a\nLeafcutter Colony", "style": "title", "pos": "middle", "fade": 1.2},
			{"t": 7.5, "until": 13.5, "text": "Sealed deep underground, a young queen starts her colony."},
			{"t": 14, "until": 19.5, "text": "Beside her grows a fungus garden, from a pellet carried from her mother's nest."},
			{"t": 20, "until": 25, "text": "She lays her first eggs."},
			{"t": 27, "until": 32, "text": "Egg, larva, pupa, worker", "style": "chapter", "pos": "top"},
			{"t": 30, "until": 36, "text": "The egg hatches. Nurses feed the larva on the fungus's swollen tips."},
			{"t": 38, "until": 44.5, "text": "Fully grown, it rests as a pupa. Leafcutters spin no cocoon."},
			{"t": 47, "until": 52, "text": "A pale callow is freed from its pupal skin..."},
			{"t": 52.5, "until": 57, "text": "...and a new worker joins the colony."},
			{"t": 59, "until": 64, "text": "Breaking ground", "style": "chapter", "pos": "top"},
			{"t": 60.5, "until": 66, "text": "Workers dig up to the surface, and the nest opens."},
			{"t": 68, "until": 74.5, "text": "Foragers set out to find fresh leaves."},
			{"t": 77, "until": 82, "text": "Leaf to fungus", "style": "chapter", "pos": "top"},
			{"t": 82.5, "until": 88, "text": "A worker saws a fragment from the leaf and carries it home."},
			{"t": 89, "until": 95, "text": "Below, gardeners chew it to pulp and plant it in the fungus garden."},
			{"t": 96, "until": 104, "text": "The ants cannot digest leaves. They farm the fungus, and its tips feed the larvae."},
			{"t": 108, "until": 113, "text": "The trunk trail", "style": "chapter", "pos": "top"},
			{"t": 113, "until": 118, "text": "The colony has grown to hundreds. Their trail is a cleared highway."},
			{"t": 118.5, "until": 124, "text": "When debris falls across it, majors, the largest workers, carry it away."},
			{"t": 124.5, "until": 129.5, "text": "Tiny minims ride the fragments, guarding carriers from parasitic flies."},
			{"t": 131, "until": 136, "text": "Taking out the waste", "style": "chapter", "pos": "top"},
			{"t": 136, "until": 141.5, "text": "Spent garden and the dead are carried out to refuse heaps, away from the fungus."},
			{"t": 143, "until": 149, "text": "From one queen, a colony of hundreds. In time, it may hold millions."}
		],
