[gd_resource type="Resource" script_class="SpeciesDef" load_steps=9 format=3]

[ext_resource type="Script" path="res://sim/species_def.gd" id="1_species"]
[ext_resource type="Script" path="res://sim/caste_def.gd" id="2_caste"]
[ext_resource type="Script" path="res://sim/pheromone_channel_def.gd" id="3_channel"]

[sub_resource type="Resource" id="Caste_minor"]
script = ExtResource("2_caste")
id = &"minor"
size = 8.0
speed = 42.0
turn_rate = 5.0
color = Color(0.14, 0.1, 0.09, 1)
head_scale = 1.3
thorax_scale = 0.95
abdomen_scale = 1.05
mandible_size = 0.4
leg_length = 1.0
spawn_ratio = 0.8
states = PackedStringArray("explore", "follow_trail", "go_to_food", "carry_home", "deliver")
underground_states = PackedStringArray("nest_role", "nurse", "tend_queen", "tend_granary", "carry_spent", "store_seed", "dig", "carry_spoil", "go_up")
initial_state = "explore"
carry_capacity = 1.0

