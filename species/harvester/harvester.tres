[sub_resource type="Resource" id="Channel_home"]
script = ExtResource("3_channel")
name = &"home"
half_life = 30.0
diffusion = 0.6
cap = 10.0
color = Color(0.72, 0.45, 1, 1)
render_intensity = 0.32

[sub_resource type="Resource" id="Channel_food"]
script = ExtResource("3_channel")
name = &"food"
half_life = 45.0
diffusion = 0.6
cap = 10.0
color = Color(0.3, 0.95, 0.82, 1)

[resource]
script = ExtResource("1_species")
id = &"harvester"
display_name = "Harvester ants"
castes = Array[ExtResource("2_caste")]([SubResource("Caste_minor"), SubResource("Caste_major"), SubResource("Caste_queen")])
channels = Array[ExtResource("3_channel")]([SubResource("Channel_home"), SubResource("Channel_food")])
nest_type = "seed_nest"
nest_params = {
"ant_cost": 4.0,
"disc_radius": 70.0,
"max_population": 3000,
"radius": 11.0,
"sense_radius": 70.0
}
food_source_types = PackedStringArray("seed_pile")
item_types = PackedStringArray("seed", "seed_meal", "chaff")
state_params = {
"carry_home": {
"follow_channel": "home",
"home_bias": 0.3,
"home_cone_deg": 75.0,
"lay_channel": "food",
"on_arrive": "deliver"
},
"deliver": {
"next": "explore"
},
"explore": {
"follow_channel": "food",
"give_up_after": 30.0,
"lay_channel": "home",
"on_food": "go_to_food",
"on_give_up": "follow_trail"
},
"follow_trail": {
"follow_channel": "home",
"goal": "nest",
"home_bias": 0.3,
"home_cone_deg": 75.0,
"on_arrive": "explore"
},
"go_to_food": {
"lay_channel": "home",
"on_pickup": "carry_home",
"timeout": 20.0
},
"dig": {
"dig_time": 2.5,
"on_idle": "nest_role"
},
"nurse": {
"on_done": "nest_role",
"stint": 90.0
},
"tend_queen": {
"on_done": "nest_role",
"stint": 70.0
},
"tend_granary": {
"on_done": "nest_role",
"on_waste": "carry_spent",
"stint": 90.0
},
"carry_spent": {
"on_done": "nest_role"
},
"store_seed": {
"next": "nest_role"
},
"go_up": {
"next": "explore"
}
}
underground_state_params = {
"carry_home": {
"on_arrive": "store_seed"
},
"follow_trail": {
"on_arrive": "nest_role"
}
}
tunables = {
"pool_states": ["explore", "follow_trail", "tend_granary", "nurse", "tend_queen", "nest_role", "go_up", "dig"]
}
