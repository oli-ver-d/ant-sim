color = Color(0.4, 0.16, 0.06, 1)
head_scale = 1.35
thorax_scale = 1.3
abdomen_scale = 1.6
mandible_size = 0.45
leg_length = 1.05
spawn_ratio = 0.0
states = PackedStringArray()
