[gd_resource type="Resource" script_class="SpeciesDef" load_steps=10 format=3]

[ext_resource type="Script" path="res://sim/species_def.gd" id="1_species"]
[ext_resource type="Script" path="res://sim/caste_def.gd" id="2_caste"]
[ext_resource type="Script" path="res://sim/pheromone_channel_def.gd" id="3_channel"]

[sub_resource type="Resource" id="Caste_minim"]
script = ExtResource("2_caste")
id = &"minim"
size = 5.0
speed = 32.0
turn_rate = 6.0
color = Color(0.62, 0.3, 0.14, 1)
head_scale = 0.9
thorax_scale = 0.85
abdomen_scale = 0.85
mandible_size = 0.25
leg_length = 1.0
spawn_ratio = 0.25
states = PackedStringArray("assign_role", "explore", "follow_trail", "seek_ride", "hitchhike", "linger", "carry_waste")
underground_states = PackedStringArray("nest_role", "nurse", "tend_queen", "garden", "carry_spent", "dig", "carry_spoil", "go_up")
initial_state = "assign_role"
state_params = {
"explore": {
"on_food": "seek_ride"
},
"go_up": {
"next": "assign_role"
}
}
carry_capacity = 0.5

[sub_resource type="Resource" id="Caste_media"]
script = ExtResource("2_caste")
id = &"media"
size = 9.0
speed = 45.0
turn_rate = 5.0
color = Color(0.55, 0.24, 0.1, 1)
head_scale = 1.1
thorax_scale = 1.0
abdomen_scale = 0.9
mandible_size = 0.35
leg_length = 1.1
spawn_ratio = 0.65
states = PackedStringArray("explore", "follow_trail", "go_to_food", "cut_leaf", "carry_home", "deliver")
underground_states = PackedStringArray("nest_role", "carry_down", "garden", "carry_spent", "dig", "carry_spoil", "go_up")
initial_state = "explore"
carry_capacity = 1.0

[sub_resource type="Resource" id="Caste_major"]
script = ExtResource("2_caste")
id = &"major"
size = 15.0
speed = 28.0
turn_rate = 3.5
color = Color(0.48, 0.2, 0.08, 1)
head_scale = 1.6
thorax_scale = 1.0
abdomen_scale = 0.85
mandible_size = 0.8
leg_length = 1.2
spawn_ratio = 0.1
states = PackedStringArray("patrol_trail", "clear_debris", "follow_trail")
underground_states = PackedStringArray("go_up")
initial_state = "patrol_trail"
state_params = {
"follow_trail": {
"on_arrive": "patrol_trail",
"on_timeout": "patrol_trail"
},
"go_up": {
"next": "patrol_trail"
}
}
carry_capacity = 2.0

[sub_resource type="Resource" id="Caste_queen"]
script = ExtResource("2_caste")
id = &"queen"
size = 22.0
speed = 7.0
