[sub_resource type="Resource" id="Channel_home"]
script = ExtResource("3_channel")
name = &"home"
half_life = 30.0
diffusion = 0.6
cap = 10.0
color = Color(0.35, 0.6, 1, 1)
render_intensity = 0.32

[sub_resource type="Resource" id="Channel_food"]
script = ExtResource("3_channel")
name = &"food"
half_life = 45.0
diffusion = 0.6
cap = 10.0
color = Color(1, 0.72, 0.25, 1)

[resource]
script = ExtResource("1_species")
id = &"leafcutter"
display_name = "Leafcutter ants"
castes = Array[ExtResource("2_caste")]([SubResource("Caste_minim"), SubResource("Caste_media"), SubResource("Caste_major"), SubResource("Caste_queen")])
channels = Array[ExtResource("3_channel")]([SubResource("Channel_home"), SubResource("Channel_food")])
nest_type = "fungus_nest"
nest_params = {
"ant_cost": 1.5,
"brood_rate": 0.004,
"brood_reserve": 30.0,
"chamber_capacity": 150.0,
"digest_rate": 0.02,
"dump": [120.0, 40.0],
"fungus_yield": 0.6,
"initial_fungus": 60.0,
"max_chambers": 5,
"max_population": 3000,
"radius": 14.0,
"sense_radius": 70.0,
"upkeep_per_ant": 0.0002,
"waste_load": 0.25
}
food_source_types = PackedStringArray("leaf", "food_pile")
item_types = PackedStringArray("leaf_fragment", "crumb", "waste")
state_params = {
"assign_role": {
"hitchhiker": "explore",
"stayer": "linger"
},
"carry_home": {
"home_bias": 0.3,
"home_cone_deg": 75.0,
"follow_channel": "home",
"lay_channel": "food",
"on_arrive": "deliver"
},
"cut_leaf": {
"on_cut": "carry_home",
"on_lost": "explore",
"on_missed": "go_to_food"
},
"clear_debris": {
"next": "patrol_trail",
"timeout": 30.0,
"trail_channel": "food"
},
"deliver": {
"next": "explore"
},
"dig": {
"dig_time": 2.5,
"on_idle": "nest_role"
},
"nurse": {
"on_done": "nest_role",
"stint": 90.0
},
"tend_queen": {
"on_done": "nest_role",
"stint": 70.0
},
"garden": {
"cut_time": 1.6,
"on_done": "nest_role",
"on_waste": "carry_spent",
"stint": 100.0
},
"carry_spent": {
"on_done": "nest_role"
},
"carry_down": {
"next": "nest_role"
},
"go_up": {
"next": "explore"
},
"explore": {
"follow_channel": "food",
"give_up_after": 30.0,
"lay_channel": "home",
"on_food": "go_to_food",
"on_give_up": "follow_trail"
},
"follow_trail": {
"home_bias": 0.3,
"home_cone_deg": 75.0,
"follow_channel": "home",
"goal": "nest",
"on_arrive": "explore"
},
"hitchhike": {
"on_dismount": "explore"
},
"linger": {
"duration": 8.0,
"next": "carry_waste",
"radius": 90.0,
"speed_factor": 0.4
},
"carry_waste": {
"dump_spread": 18.0,
"on_done": "linger",
"on_none": "linger"
},
"patrol_trail": {
"follow_channel": "food",
"give_up_after": 45.0,
"on_debris": "clear_debris",
"on_give_up": "follow_trail",
"speed_factor": 0.7
},
"seek_ride": {
"on_lost": "explore",
"on_ride": "hitchhike",
"on_timeout": "follow_trail",
"timeout": 40.0
},
"go_to_food": {
"on_arrive": "cut_leaf",
"lay_channel": "home",
"on_pickup": "carry_home",
"timeout": 20.0
}
}
underground_state_params = {
"carry_home": {
"on_arrive": "carry_down"
},
"carry_waste": {
"on_done": "nest_role",
"on_none": "nest_role"
},
"follow_trail": {
"on_arrive": "nest_role"
}
}
tunables = {
"bite_radius": 6.0,
"pool_states": ["explore", "follow_trail", "linger", "patrol_trail", "seek_ride", "garden", "nurse", "tend_queen", "nest_role", "go_up", "dig"],
"debris_carry_distance": 55.0,
"debris_scan_interval": 6,
"debris_sense_radius": 45.0,
"debris_trail_threshold": 0.35,
"hitchhiker_fraction": 0.5,
"max_riders": 1,
"ride_item_type": "leaf_fragment",
"seek_ride_reach": 8.0,
"cut_jitter_angle": 0.22,
"cut_jitter_hz": 3.0,
"cut_time": {
"major": 4.5,
"media": 3.0,
"minim": 2.0
}
}
