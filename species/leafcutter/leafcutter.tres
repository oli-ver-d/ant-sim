[gd_resource type="Resource" script_class="SpeciesDef" load_steps=9 format=3]

[ext_resource type="Script" path="res://sim/species_def.gd" id="1_species"]
[ext_resource type="Script" path="res://sim/caste_def.gd" id="2_caste"]
[ext_resource type="Script" path="res://sim/pheromone_channel_def.gd" id="3_channel"]

[sub_resource type="Resource" id="Caste_minim"]
script = ExtResource("2_caste")
id = &"minim"
size = 5.0
speed = 32.0
turn_rate = 6.0
color = Color(0.62, 0.3, 0.14, 1)
head_scale = 0.9
thorax_scale = 0.85
abdomen_scale = 0.85
mandible_size = 0.25
leg_length = 1.0
spawn_ratio = 0.25
states = PackedStringArray("assign_role", "explore", "follow_trail", "seek_ride", "hitchhike", "linger")
initial_state = "assign_role"
state_params = {
"explore": {
"on_food": "seek_ride"
}
}
carry_capacity = 0.5

[sub_resource type="Resource" id="Caste_media"]
script = ExtResource("2_caste")
id = &"media"
size = 9.0
speed = 45.0
turn_rate = 5.0
color = Color(0.55, 0.24, 0.1, 1)
head_scale = 1.1
thorax_scale = 1.0
abdomen_scale = 0.9
mandible_size = 0.35
leg_length = 1.1
spawn_ratio = 0.65
states = PackedStringArray("explore", "follow_trail", "go_to_food", "cut_leaf", "carry_home", "deliver")
initial_state = "explore"
carry_capacity = 1.0

[sub_resource type="Resource" id="Caste_major"]
script = ExtResource("2_caste")
id = &"major"
size = 15.0
speed = 28.0
turn_rate = 3.5
color = Color(0.48, 0.2, 0.08, 1)
head_scale = 1.6
thorax_scale = 1.0
abdomen_scale = 0.85
mandible_size = 0.8
leg_length = 1.2
spawn_ratio = 0.1
states = PackedStringArray("patrol_trail", "clear_debris", "follow_trail")
initial_state = "patrol_trail"
state_params = {
"follow_trail": {
"on_arrive": "patrol_trail"
}
}
carry_capacity = 2.0

[sub_resource type="Resource" id="Channel_home"]
script = ExtResource("3_channel")
name = &"home"
half_life = 30.0
diffusion = 0.6
cap = 10.0
color = Color(0.35, 0.6, 1, 1)
render_intensity = 0.32

[sub_resource type="Resource" id="Channel_food"]
script = ExtResource("3_channel")
name = &"food"
half_life = 45.0
diffusion = 0.6
cap = 10.0
color = Color(1, 0.72, 0.25, 1)

[resource]
script = ExtResource("1_species")
id = &"leafcutter"
display_name = "Leafcutter ants"
castes = Array[ExtResource("2_caste")]([SubResource("Caste_minim"), SubResource("Caste_media"), SubResource("Caste_major")])
channels = Array[ExtResource("3_channel")]([SubResource("Channel_home"), SubResource("Channel_food")])
nest_type = "basic_nest"
nest_params = {
"ant_cost": 3.0,
"max_population": 3000,
"radius": 14.0,
"sense_radius": 70.0
}
food_source_types = PackedStringArray("leaf", "food_pile")
item_types = PackedStringArray("leaf_fragment", "crumb")
state_params = {
"assign_role": {
"hitchhiker": "explore",
"stayer": "linger"
},
"carry_home": {
"home_bias": 0.3,
"home_cone_deg": 75.0,
"follow_channel": "home",
"lay_channel": "food",
"on_arrive": "deliver"
},
"cut_leaf": {
"on_cut": "carry_home",
"on_lost": "explore",
"on_missed": "go_to_food"
},
"clear_debris": {
"next": "patrol_trail",
"timeout": 30.0,
"trail_channel": "food"
},
"deliver": {
"next": "explore"
},
"explore": {
"follow_channel": "food",
"give_up_after": 30.0,
"lay_channel": "home",
"on_food": "go_to_food",
"on_give_up": "follow_trail"
},
"follow_trail": {
"home_bias": 0.3,
"home_cone_deg": 75.0,
"follow_channel": "home",
"goal": "nest",
"on_arrive": "explore"
},
"hitchhike": {
"on_dismount": "explore"
},
"linger": {
"radius": 90.0,
"speed_factor": 0.4
},
"patrol_trail": {
"follow_channel": "food",
"give_up_after": 45.0,
"on_debris": "clear_debris",
"on_give_up": "follow_trail",
"speed_factor": 0.7
},
"seek_ride": {
"on_lost": "explore",
"on_ride": "hitchhike",
"on_timeout": "follow_trail",
"timeout": 40.0
},
"go_to_food": {
"on_arrive": "cut_leaf",
"lay_channel": "home",
"on_pickup": "carry_home",
"timeout": 20.0
}
}
tunables = {
"bite_radius": 6.0,
"debris_carry_distance": 55.0,
"debris_scan_interval": 6,
"debris_sense_radius": 45.0,
"debris_trail_threshold": 0.35,
"hitchhiker_fraction": 0.5,
"max_riders": 1,
"ride_item_type": "leaf_fragment",
"seek_ride_reach": 8.0,
"cut_jitter_angle": 0.22,
"cut_jitter_hz": 3.0,
"cut_time": {
"major": 4.5,
"media": 3.0,
"minim": 2.0
}
}
