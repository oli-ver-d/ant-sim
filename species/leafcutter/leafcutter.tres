[resource]
script = ExtResource("1_species")
id = &"leafcutter"
display_name = "Leafcutter ants"
castes = Array[ExtResource("2_caste")]([SubResource("Caste_minim"), SubResource("Caste_media"), SubResource("Caste_major")])
channels = Array[ExtResource("3_channel")]([SubResource("Channel_home"), SubResource("Channel_food")])
nest_type = "basic_nest"
nest_params = {
"ant_cost": 3.0,
"max_population": 3000,
"radius": 14.0,
"sense_radius": 70.0
}
food_source_types = PackedStringArray("food_pile")
item_types = PackedStringArray("crumb")
state_params = {
"carry_home": {
"follow_channel": "home",
"lay_channel": "food",
"on_arrive": "deliver"
},
"deliver": {
"next": "explore"
},
"explore": {
"follow_channel": "food",
"give_up_after": 20.0,
"lay_channel": "home",
"on_food": "go_to_food",
"on_give_up": "follow_trail"
},
"follow_trail": {
"follow_channel": "home",
"goal": "nest",
"on_arrive": "explore"
},
"go_to_food": {
"lay_channel": "home",
"on_pickup": "carry_home",
"timeout": 20.0
}
}
